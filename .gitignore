# Build output
build/
/out/
/output/
cmake-build-*/

# CMake artifacts (in case of an in-source configure)
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
Makefile
*.ninja
.ninja_deps
.ninja_log

# Binaries / objects
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.o
*.a
*.lib
*.so
*.dylib

# Editors / IDEs
.vs/
.vscode/
.idea/
.cache/
*.user

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Third-party content that is not ours to redistribute.
#
# Source photographs used for testing -- rendering them is fine, publishing them
# is not, unless you own them. Drop your own pictures in here; nothing in the
# project depends on any particular file being present.
assets/images/
assets/videos/

# Bundled fonts. The default is now whichever monospace face the OS already has
# (picked per-OS in app/CMakeLists.txt), so no font needs shipping. A copy left
# here still works locally and stays out of the repository.
assets/fonts/

# assets/showcase/ is deliberately NOT ignored -- those are rendered output,
# committed so the README has something to show.

# Local convenience scripts: build/run/install wrappers around the CMake
# presets, plus the profiling and showcase runners. Machine-specific (paths,
# fonts, which sample images exist) and not part of the project's interface.
commands/
